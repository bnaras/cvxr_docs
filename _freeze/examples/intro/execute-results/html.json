n:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 1 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n  </tr>\n  <tr>\n   <td style=\"text-align:left;background-color: rgba(236, 236, 236, 1) !important;\"> \\(\\beta_{9}\\) </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 1 </td>\n   <td style=\"text-align:right;background-color: rgba(236, 236, 236, 1) !important;\"> 0 </td>\n  </tr>\n  <tr>\n   <td style=\"text-align:left;backg